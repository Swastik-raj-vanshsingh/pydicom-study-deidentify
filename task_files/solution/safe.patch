+"""De-identify a study directory for release to a research partner.
+
+``pydicom deidentify INPUT_DIR OUTPUT_DIR --crosswalk FILE``
+
+Every DICOM file found under ``INPUT_DIR`` is de-identified according to the
+DICOM Basic Application Level Confidentiality Profile (PS3.15 Annex E) with the
+"Retain Longitudinal Temporal Information with Modified Dates" and "Retain
+Patient Characteristics" options, and written under ``OUTPUT_DIR``. The mapping
+from the original patient identifiers to the pseudonyms is written to the
+crosswalk file for the honest broker and never travels with the release.
+"""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import datetime
+import hashlib
+import json
+import os
+import re
+import secrets
+import stat
+import sys
+from pathlib import Path
+from typing import Any
+
+from pydicom import dcmread
+from pydicom.dataelem import DataElement
+from pydicom.dataset import Dataset, FileMetaDataset
+from pydicom.errors import InvalidDicomError
+from pydicom.sequence import Sequence
+from pydicom.tag import Tag
+from pydicom.uid import UID, generate_uid, ExplicitVRLittleEndian
+from pydicom.valuerep import DA, DT, TM
+
+DEFAULT_PROFILE = "/opt/reference/dicom_confidentiality_profile.json"
+
+# Coded entries for the Basic Profile and the two options, from PS3.16 CID 7050.
+DEID_CODES = (
+    ("113100", "Basic Application Confidentiality Profile"),
+    ("113107", "Retain Longitudinal Temporal Information Modified Dates Option"),
+    ("113108", "Retain Patient Characteristics Option"),
+)
+
+# Under the Retain Patient Characteristics option these attributes stay.
+RETAINED_CHARACTERISTICS = {
+    Tag(0x0010, 0x0040),  # Patient's Sex
+    Tag(0x0010, 0x1010),  # Patient's Age
+    Tag(0x0010, 0x1020),  # Patient's Size
+    Tag(0x0010, 0x1030),  # Patient's Weight
+    Tag(0x0010, 0x2160),  # Ethnic Group
+    Tag(0x0010, 0x21A0),  # Smoking Status
+    Tag(0x0010, 0x21C0),  # Pregnancy Status
+    Tag(0x0010, 0x2110),  # Allergies
+}
+
+# Under the Retain Longitudinal Temporal Information with Modified Dates
+# option, dates and times are moved rather than removed.
+DATE_VRS = {"DA", "DT", "TM"}
+
+# The record of what was done to the file.
+METHOD_TAGS = {
+    Tag(0x0012, 0x0062),  # Patient Identity Removed
+    Tag(0x0012, 0x0063),  # De-identification Method
+    Tag(0x0012, 0x0064),  # De-identification Method Code Sequence
+}
+
+# Attributes that decide whether an image may carry burned-in text.
+SECONDARY_IMAGE_TYPES = ("SECONDARY", "SCREEN SAVE", "SCREENSAVE")
+# A secondary capture is one by its SOP Class whatever Image Type says.
+SECONDARY_CAPTURE_CLASSES = {
+    "1.2.840.10008.5.1.4.1.1.7",
+    "1.2.840.10008.5.1.4.1.1.7.1",
+    "1.2.840.10008.5.1.4.1.1.7.2",
+    "1.2.840.10008.5.1.4.1.1.7.3",
+    "1.2.840.10008.5.1.4.1.1.7.4",
+}
+
+MAX_AGE = 90
+
+_TAG_RE = re.compile(r"\(([0-9A-Fa-fXx]{4}),([0-9A-Fa-fXx]{4})\)")
+
+
+class ReleaseRefused(Exception):
+    """The file cannot be released as de-identified."""
+
+
+def add_subparser(subparsers: argparse._SubParsersAction) -> None:
+    subparser = subparsers.add_parser(
+        "deidentify",
+        description=(
+            "De-identify every DICOM file under INPUT_DIR into OUTPUT_DIR "
+            "following the Basic Application Level Confidentiality Profile "
+            "with the Retain Longitudinal Temporal Information with Modified "
+            "Dates and Retain Patient Characteristics options."
+        ),
+    )
+    subparser.add_argument("input_dir", help="directory holding the study")
+    subparser.add_argument("output_dir", help="directory to write the release into")
+    subparser.add_argument(
+        "--crosswalk",
+        required=True,
+        help="CSV mapping original patient identifiers to pseudonyms, for the "
+        "honest broker only",
+    )
+    subparser.add_argument(
+        "--patient-prefix",
+        default="RSCH",
+        help="prefix for the pseudonymous patient identifiers (default RSCH)",
+    )
+    subparser.add_argument(
+        "--profile",
+        default=DEFAULT_PROFILE,
+        help="machine readable copy of the confidentiality profile table",
+    )
+    subparser.set_defaults(func=do_command)
+
+
+# --------------------------------------------------------------------------
+# The profile table
+# --------------------------------------------------------------------------
+
+
+class Profile:
+    """The per-attribute actions of the Basic Profile, with wildcard groups."""
+
+    def __init__(self, entries: list[dict[str, Any]]) -> None:
+        self.exact: dict[int, str] = {}
+        self.patterns: list[tuple[re.Pattern[str], str]] = []
+        for entry in entries:
+            action = entry.get("basicProfile") or ""
+            tag = entry.get("tag") or ""
+            match = _TAG_RE.match(tag)
+            if not match:
+                continue
+            group, element = match.group(1).upper(), match.group(2).upper()
+            if "X" in group or "X" in element:
+                pattern = re.compile(
+                    "^" + group.replace("X", "[0-9A-F]") + element.replace("X", "[0-9A-F]") + "$"
+                )
+                self.patterns.append((pattern, action))
+            else:
+                self.exact[(int(group, 16) << 16) | int(element, 16)] = action
+
+    @classmethod
+    def load(cls, path: str) -> "Profile":
+        with open(path, "r", encoding="utf-8") as handle:
+            return cls(json.load(handle))
+
+    def action_for(self, tag: Tag) -> str | None:
+        if int(tag) in self.exact:
+            return self.exact[int(tag)]
+        key = "%04X%04X" % (tag.group, tag.element)
+        for pattern, action in self.patterns:
+            if pattern.match(key):
+                return action
+        return None
+
+
+# --------------------------------------------------------------------------
+# Consistent replacements within one run
+# --------------------------------------------------------------------------
+
+
+class Study:
+    """Everything that has to agree across the files of one run."""
+
+    def __init__(self, prefix: str) -> None:
+        self.prefix = prefix
+        self.uids: dict[str, str] = {}
+        self.patients: dict[str, dict[str, str]] = {}
+        self.offsets: dict[str, int] = {}
+        self._salt = secrets.token_hex(16)
+
+    def uid(self, original: str) -> str:
+        original = str(original).strip()
+        if not original:
+            return generate_uid()
+        if original not in self.uids:
+            self.uids[original] = generate_uid()
+        return self.uids[original]
+
+    @staticmethod
+    def identity(original_id: str, issuer: str) -> str:
+        """One patient: an identifier within the authority that issued it.
+
+        The directory holds exports from several hospitals, and a Patient ID
+        is only unique within its Issuer of Patient ID.
+        """
+        return "%s\x1f%s" % (str(original_id).strip() or "<no id>", str(issuer).strip())
+
+    def pseudonym(self, original_id: str, original_name: str, issuer: str = "") -> str:
+        key = self.identity(original_id, issuer)
+        if key not in self.patients:
+            number = len(self.patients) + 1
+            self.patients[key] = {
+                "original_patient_id": str(original_id).strip() or "<no id>",
+                "original_patient_name": str(original_name),
+                "pseudonym": "%s-%04d" % (self.prefix, number),
+            }
+        return self.patients[key]["pseudonym"]
+
+    def offset_days(self, identity_key: str, issuer: str | None = None) -> int:
+        key = identity_key if issuer is None else self.identity(identity_key, issuer)
+        if key not in self.offsets:
+            digest = hashlib.sha256((self._salt + key).encode("utf-8")).digest()
+            # Between 31 and 400 days back: never a real date, always the same
+            # shift for every date belonging to one patient.
+            self.offsets[key] = -(31 + int.from_bytes(digest[:2], "big") % 370)
+        return self.offsets[key]
+
+
+# --------------------------------------------------------------------------
+# Per-element actions
+# --------------------------------------------------------------------------
+
+
+def _shift_date(value: str, days: int) -> str:
+    text = str(value).strip()
+    if len(text) < 8:
+        return ""
+    try:
+        date = datetime.date(int(text[:4]), int(text[4:6]), int(text[6:8]))
+    except ValueError:
+        return ""
+    return (date + datetime.timedelta(days=days)).strftime("%Y%m%d")
+
+
+def _shift_datetime(value: str, days: int) -> str:
+    text = str(value).strip()
+    if len(text) < 8:
+        return ""
+    head = _shift_date(text[:8], days)
+    if not head:
+        return ""
+    return head + text[8:]
+
+
+def _dummy_for(elem: DataElement) -> Any:
+    vr = elem.VR
+    if vr == "SQ":
+        return Sequence()
+    if vr in ("DA",):
+        return "19000101"
+    if vr in ("DT",):
+        return "19000101000000"
+    if vr in ("TM",):
+        return "000000"
+    if vr in ("UI",):
+        return generate_uid()
+    if vr in ("PN",):
+        return "REMOVED^REMOVED"
+    if vr in ("US", "SS", "UL", "SL", "FL", "FD", "IS", "DS", "UV", "SV"):
+        return 0
+    return "REMOVED"
+
+
+def _apply(
+    dataset: Dataset,
+    elem: DataElement,
+    action: str,
+    study: Study,
+    patient_id: str,
+) -> None:
+    """Carry out one profile action on one element in place."""
+    tag = elem.tag
+    if elem.VR in DATE_VRS:
+        # Retain Longitudinal Temporal Information with Modified Dates: the
+        # value moves by the patient's offset instead of being removed.
+        days = study.offset_days(patient_id)  # patient_id is the identity key
+        if elem.VR == "TM":
+            return  # a time alone carries no calendar information
+        shifted = [
+            _shift_datetime(v, days) if elem.VR == "DT" else _shift_date(v, days)
+            for v in (elem.value if elem.VM > 1 else [elem.value])
+        ]
+        elem.value = shifted if elem.VM > 1 else shifted[0]
+        return
+    if "U" in action and elem.VR == "UI":
+        if elem.VM > 1:
+            elem.value = [study.uid(v) for v in elem.value]
+        else:
+            elem.value = study.uid(str(elem.value))
+        return
+    if action.startswith("X"):
+        del dataset[tag]
+        return
+    if action.startswith("Z"):
+        if elem.VR == "SQ":
+            elem.value = Sequence()
+        else:
+            elem.value = None
+        return
+    if action.startswith("D"):
+        elem.value = _dummy_for(elem)
+        return
+    # Anything else the table lists but does not decide for us: remove it.
+    del dataset[tag]
+
+
+def _clean(dataset: Dataset, profile: Profile, study: Study, patient_id: str) -> None:
+    """Walk one dataset, recursing into every sequence item."""
+    for tag in sorted(dataset.keys()):
+        if tag not in dataset:
+            continue
+        elem = dataset[tag]
+        if tag in METHOD_TAGS:
+            continue
+        if tag.is_private:
+            del dataset[tag]
+            continue
+        if tag in RETAINED_CHARACTERISTICS:
+            if tag == Tag(0x0010, 0x1010):
+                _cap_age(elem)
+            continue
+        if elem.VR == "SQ" and not isinstance(elem.value, (str, bytes)):
+            action = profile.action_for(tag)
+            if action and "U*" in action:
+                # The table's U*: keep the sequence, replace the UIDs inside
+                # it. Each of those has its own row, so recursing is enough.
+                for item in elem.value:
+                    _clean(item, profile, study, patient_id)
+                continue
+            if action and action.startswith("X"):
+                del dataset[tag]
+                continue
+            for item in elem.value:
+                _clean(item, profile, study, patient_id)
+            continue
+        if elem.VR in DATE_VRS:
+            _apply(dataset, elem, "C", study, patient_id)
+            continue
+        action = profile.action_for(tag)
+        if action is None:
+            if elem.VR == "UI" and tag.group not in (0x0002, 0x0008):
+                # Unlisted UIDs that still identify an instance are remapped
+                # so references stay consistent.
+                pass
+            continue
+        _apply(dataset, elem, action, study, patient_id)
+
+
+def _cap_age(elem: DataElement) -> None:
+    text = str(elem.value).strip()
+    if len(text) == 4 and text[-1] == "Y" and text[:3].isdigit():
+        if int(text[:3]) >= MAX_AGE:
+            elem.value = "%03dY" % MAX_AGE
+
+
+def _years_from_dates(dataset: Dataset) -> int | None:
+    """The patient's age on the study date, uncapped, or None."""
+    birth = str(dataset.get("PatientBirthDate", "") or "").strip()
+    when = str(dataset.get("StudyDate", "") or "").strip()
+    if len(birth) < 8 or len(when) < 8:
+        return None
+    try:
+        b = datetime.date(int(birth[:4]), int(birth[4:6]), int(birth[6:8]))
+        w = datetime.date(int(when[:4]), int(when[4:6]), int(when[6:8]))
+    except ValueError:
+        return None
+    return max(w.year - b.year - ((w.month, w.day) < (b.month, b.day)), 0)
+
+
+def _stated_years(dataset: Dataset) -> int | None:
+    text = str(dataset.get("PatientAge", "") or "").strip()
+    if len(text) == 4 and text[-1] == "Y" and text[:3].isdigit():
+        return int(text[:3])
+    return None
+
+
+def _age_from_dates(dataset: Dataset) -> str | None:
+    years = _years_from_dates(dataset)
+    if years is None:
+        return None
+    return "%03dY" % min(years, MAX_AGE)
+
+
+def _overlay_in_pixel_bits(dataset: Dataset) -> str | None:
+    """An overlay plane kept in the unused high bits of Pixel Data.
+
+    Older scanners did this (the usage is retired): Bits Stored is smaller than
+    Bits Allocated and the overlay group's Overlay Bit Position points at a bit
+    above the stored range. There is no (60xx,3000) for the profile to remove;
+    the text is in the pixels.
+    """
+    if "PixelData" not in dataset:
+        return None
+    try:
+        stored = int(dataset.get("BitsStored", 0) or 0)
+        allocated = int(dataset.get("BitsAllocated", 0) or 0)
+    except (TypeError, ValueError):
+        return None
+    if not stored or stored >= allocated:
+        return None
+    for elem in dataset:
+        if 0x6000 <= elem.tag.group <= 0x60FF and elem.tag.element == 0x0102:
+            try:
+                position = int(elem.value)
+            except (TypeError, ValueError):
+                continue
+            if position >= stored and Tag(elem.tag.group, 0x3000) not in dataset:
+                return "overlay plane stored in the unused bits of Pixel Data"
+    return None
+
+
+def _may_carry_burned_in_text(dataset: Dataset) -> str | None:
+    """Why the image must not be released as de-identified, or None."""
+    burned = str(dataset.get("BurnedInAnnotation", "") or "").strip().upper()
+    if burned == "YES":
+        return "Burned In Annotation is YES"
+    if str(dataset.get("SOPClassUID", "") or "") in SECONDARY_CAPTURE_CLASSES:
+        return "SOP Class is Secondary Capture"
+    embedded = _overlay_in_pixel_bits(dataset)
+    if embedded:
+        return embedded
+    image_type = dataset.get("ImageType")
+    if image_type is not None:
+        values = [str(v).upper() for v in (image_type if dataset["ImageType"].VM > 1 else [image_type])]
+        for value in values:
+            for marker in SECONDARY_IMAGE_TYPES:
+                if marker in value:
+                    return "Image Type is %s" % "\\".join(values)
+    return None
+
+
+def _referenced_instances(dataset: Dataset) -> set[str]:
+    found: set[str] = set()
+    for elem in dataset.iterall():
+        if elem.tag == Tag(0x0008, 0x1155) and elem.value:
+            values = elem.value if elem.VM > 1 else [elem.value]
+            found.update(str(v) for v in values)
+    return found
+
+
+def deidentify_dataset(
+    dataset: Dataset, profile: Profile, study: Study, refused_uids: set[str] | None = None
+) -> tuple[str, str]:
+    """De-identify one dataset in place. Returns (pseudonym, original id)."""
+    # Nothing about this file touches the study-wide state until the file
+    # has shown it can be released at all: a broken file must not leave a
+    # phantom patient in the crosswalk.
+    if "SOPInstanceUID" not in dataset or not str(dataset.SOPInstanceUID).strip():
+        raise ValueError("no SOP Instance UID; not a releasable instance")
+    reason = _may_carry_burned_in_text(dataset)
+    if reason:
+        raise ReleaseRefused(reason)
+    # A file that points at an instance the run holds back would leave the
+    # partner with a reference to nothing; it goes the same way as its target.
+    if refused_uids:
+        pointing_at = _referenced_instances(dataset) & refused_uids
+        if pointing_at:
+            raise ReleaseRefused("refers to an instance that was not released")
+
+    original_id = str(dataset.get("PatientID", "") or "")
+    original_name = str(dataset.get("PatientName", "") or "")
+    issuer = str(dataset.get("IssuerOfPatientID", "") or "")
+    pseudonym = study.pseudonym(original_id, original_name, issuer)
+
+    # Age is derived before the dates move, then kept under the option.
+    years = _stated_years(dataset)
+    if years is None:
+        years = _years_from_dates(dataset)
+    if "PatientAge" not in dataset:
+        derived = _age_from_dates(dataset)
+        if derived:
+            dataset.PatientAge = derived
+
+    _clean(dataset, profile, study, study.identity(original_id, issuer))
+
+    # Capping Patient's Age is not enough on its own. Shifting every date by
+    # one offset keeps the interval between them, and the interval from the
+    # birth date to the study date *is* the exact age the cap exists to hide.
+    # For those patients the birth date is emptied, which is the action the
+    # profile's own table gives it.
+    if years is not None and years >= MAX_AGE and "PatientBirthDate" in dataset:
+        dataset.PatientBirthDate = None
+
+    dataset.PatientID = pseudonym
+    dataset.PatientName = pseudonym
+
+    # The record of what was done, stated truthfully.
+    dataset.PatientIdentityRemoved = "YES"
+    # LO is limited to 64 characters; the code sequence carries the detail.
+    dataset.DeidentificationMethod = "Basic Profile; Modified Dates; Patient Characteristics"
+    codes = Sequence()
+    for value, meaning in DEID_CODES:
+        item = Dataset()
+        item.CodeValue = value
+        item.CodingSchemeDesignator = "DCM"
+        item.CodeMeaning = meaning
+        codes.append(item)
+    dataset.DeidentificationMethodCodeSequence = codes
+    return pseudonym, original_id
+
+
+def _rebuild_file_meta(dataset: Dataset) -> None:
+    """The file header must describe the file it now fronts."""
+    meta = getattr(dataset, "file_meta", None)
+    if meta is None:
+        meta = FileMetaDataset()
+    old = FileMetaDataset()
+    old.update(meta)
+    meta = FileMetaDataset()
+    meta.MediaStorageSOPClassUID = dataset.get(
+        "SOPClassUID", old.get("MediaStorageSOPClassUID", "")
+    )
+    meta.MediaStorageSOPInstanceUID = dataset.SOPInstanceUID
+    meta.TransferSyntaxUID = old.get("TransferSyntaxUID", ExplicitVRLittleEndian)
+    dataset.file_meta = meta
+
+
+# --------------------------------------------------------------------------
+# Files
+# --------------------------------------------------------------------------
+
+
+def _is_dicom(path: Path) -> bool:
+    try:
+        with open(path, "rb") as handle:
+            handle.seek(128)
+            return handle.read(4) == b"DICM"
+    except OSError:
+        return False
+
+
+def _iter_candidates(root: Path):
+    for dirpath, dirnames, filenames in os.walk(root):
+        dirnames.sort()
+        for name in sorted(filenames):
+            yield Path(dirpath) / name
+
+
+def _private(path: Path, mode: int) -> None:
+    try:
+        os.chmod(path, mode)
+    except OSError:
+        pass
+
+
+def _open_new(path: Path) -> int:
+    """Create a file that must not already exist, readable by us alone."""
+    return os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+
+
+def _write_crosswalk(path: Path, study: Study) -> None:
+    fd = _open_new(path)
+    with os.fdopen(fd, "w", newline="", encoding="utf-8") as handle:
+        writer = csv.writer(handle)
+        writer.writerow(["original_patient_id", "original_patient_name", "pseudonym"])
+        for row in study.patients.values():
+            writer.writerow([
+                _spreadsheet_safe(row["original_patient_id"]),
+                _spreadsheet_safe(row["original_patient_name"]),
+                row["pseudonym"],
+            ])
+
+
+def _spreadsheet_safe(value: str) -> str:
+    text = "" if value is None else str(value)
+    if text[:1] in ("=", "+", "-", "@", "\t", "\r"):
+        return "'" + text
+    return text
+
+
+def do_command(args: argparse.Namespace) -> None:
+    input_dir = Path(args.input_dir).resolve()
+    output_dir = Path(args.output_dir).resolve()
+    crosswalk = Path(args.crosswalk).resolve()
+
+    if not input_dir.is_dir():
+        sys.exit("input directory does not exist: %s" % input_dir)
+    if output_dir == input_dir or input_dir in output_dir.parents:
+        sys.exit("the output directory must not be inside the input directory")
+    if crosswalk == output_dir or output_dir in crosswalk.parents:
+        sys.exit("the crosswalk must not be written inside the release directory")
+    if crosswalk.exists():
+        sys.exit("refusing to overwrite an existing crosswalk: %s" % crosswalk)
+
+    profile = Profile.load(args.profile)
+    study = Study(args.patient_prefix)
+
+    output_dir.mkdir(parents=True, exist_ok=True)
+    _private(output_dir, 0o700)
+
+    written = refused = failed = skipped = 0
+    candidates = list(_iter_candidates(input_dir))
+
+    # First pass: which instances will be held back. Anything that refers to
+    # one of them must not go out either, whatever order the files sort in.
+    refused_uids: set[str] = set()
+    for path in candidates:
+        if not _is_dicom(path):
+            continue
+        try:
+            header = dcmread(str(path), stop_before_pixels=False)
+        except Exception:
+            continue
+        if _may_carry_burned_in_text(header):
+            instance = str(header.get("SOPInstanceUID", "") or "").strip()
+            if instance:
+                refused_uids.add(instance)
+
+    for path in candidates:
+        if not _is_dicom(path):
+            skipped += 1
+            continue
+        try:
+            dataset = dcmread(str(path))
+            deidentify_dataset(dataset, profile, study, refused_uids)
+            _rebuild_file_meta(dataset)
+            target = output_dir / ("%s.dcm" % dataset.SOPInstanceUID)
+            temporary = output_dir / (".%s.part" % dataset.SOPInstanceUID)
+            fd = _open_new(temporary)
+            try:
